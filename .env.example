# ML Forge local configuration. Copy to .env (never commit .env).

# Optional AI mentor. Without it, every non-AI feature works.
# Read only by the backend; never sent to the browser or written to logs/backups.
ANTHROPIC_API_KEY=

# Model for the mentor (default claude-opus-5-5)
# MLFORGE_AI_MODEL=claude-opus-5-5

# Where SQLite and backups live (default ./data)
# MLFORGE_DATA_DIR=./data

# Sandbox limits for regular Python exercises
# MLFORGE_SANDBOX_TIMEOUT_S=5
# MLFORGE_SANDBOX_MEMORY_MB=256

# Next.js -> API proxy target. Build-time setting: rebuild the web app after changing it.
# MLFORGE_API_ORIGIN=http://127.0.0.1:8000
